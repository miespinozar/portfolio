---
import { url } from "@/utils/url";
import "../styles/global.css";

// Cada página puede pasar su propio título y descripción.
// Si no pasa nada, se usan los de abajo.
interface Props {
  title?: string;
  description?: string;
}

const nombre = "Matías Espinoza";

const {
  title,
  description = "Portafolio de Matías Espinoza, Ingeniero Civil en Informática y desarrollador: experiencia, educación, tecnologías y contacto.",
} = Astro.props;

// Pestaña del navegador: "Sobre Matías | Matías Espinoza", o solo el nombre en el inicio.
const tituloCompleto = title
  ? `${title} | ${nombre}`
  : `${nombre} | Ingeniero Civil en Informática y Desarrollador`;

// Dirección completa de esta página y de la imagen para compartir.
const direccion = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(url("/og-image.png"), Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />

    <!-- Ícono de la pestaña: las iniciales "ME" (el .ico es para navegadores antiguos) -->
    <link rel="icon" href={url("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- El sitio es oscuro: así el navegador también pinta oscuras sus barras de
         desplazamiento y su fondo mientras carga (se nota sobre todo en Firefox). -->
    <meta name="color-scheme" content="dark" />

    <!-- Si en otra página pausaste las animaciones, siguen pausadas desde el primer
         cuadro (ver el botón "Pausar" de los carruseles, abajo). -->
    <script is:inline>
      try {
        if (localStorage.getItem("animaciones") === "pausadas") {
          document.documentElement.setAttribute("data-animaciones-pausadas", "");
        }
      } catch {}
    </script>

    <!-- Título y descripción: lo que muestra Google -->
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />

    <!-- Vista previa al compartir el link (LinkedIn, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />

    <!-- Imagen y dirección de la página para esa vista previa.
         Tienen que ser direcciones completas, por eso se arman con `site` (astro.config.mjs). -->
    <meta property="og:url" content={direccion} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Matías Espinoza, Ingeniero Civil en Informática" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={direccion} />

    <!-- Sin JavaScript no hay animación de aparición: todo se muestra de inmediato -->
    <noscript>
      <style>
        /* !important: este estilo se carga antes que global.css y, sin eso, pierde */
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }

        /* El botón de pausa necesita JavaScript; sin él no se muestra. */
        [data-pausar] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class="
  min-h-screen
  text-gray-200
  bg-[radial-gradient(ellipse_at_top,_#1e293b,_#020617)]
">
    <!-- Primer elemento con Tab: salta el menú y va directo al contenido de la página.
         Se ve solo al enfocarlo. Cada página pone id="contenido" en su <main>. -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only
             focus:fixed focus:top-3 focus:left-3 focus:z-[60]
             focus:px-4 focus:py-2 focus:rounded-lg
             focus:bg-purple-600 focus:text-white focus:font-semibold"
    >
      Saltar al contenido
    </a>

    <slot />

    <script>
      // Botón "Pausar" de los carruseles (TechStack y las pestañas de Experiencia).
      // Pausa todas las animaciones del sitio a la vez y lo recuerda entre páginas.
      // El texto del botón (Pausar / Reanudar) lo cambia el CSS según el atributo de <html>.
      document.addEventListener("click", (evento) => {
        const boton = (evento.target as Element | null)?.closest("[data-pausar]");
        if (!boton) {
          return;
        }

        const raiz = document.documentElement;
        const pausadas = !raiz.hasAttribute("data-animaciones-pausadas");
        raiz.toggleAttribute("data-animaciones-pausadas", pausadas);

        try {
          if (pausadas) {
            localStorage.setItem("animaciones", "pausadas");
          } else {
            localStorage.removeItem("animaciones");
          }
        } catch {}
      });
    </script>

    <script>
      // Animación de aparición: cada elemento con la clase `reveal`
      // se muestra la primera vez que entra en pantalla.
      const observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (entrada.isIntersecting) {
              entrada.target.classList.add("visible");

              // Ya apareció: no hace falta seguir mirándolo
              observador.unobserve(entrada.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll(".reveal").forEach((elemento) => {
        observador.observe(elemento);
      });
    </script>
  </body>
</html>
