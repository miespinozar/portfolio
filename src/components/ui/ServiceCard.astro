---
import Card from "@/components/ui/Card.astro";

// Tarjeta de "Cómo trabaja": arriba los logos de las herramientas principales
// de esa área, luego el título y la descripción.
// Cada logo trae su path SVG y, si no está dibujado en 24×24, su `viewBox`.
type Logo = {
  name: string;
  path: string;
  viewBox?: string;
};

interface Props {
  logos: Logo[];
  title: string;
  description: string;
}

const { logos, title, description } = Astro.props;
---

<Card
  class={`w-full p-8
          border-purple-500/40
          hover:border-purple-400`}
>
  <!-- Logos -->
  <ul class="flex flex-wrap items-center gap-4 mb-6">
    {logos.map((logo) => (
      <li title={logo.name}>
        <svg
          viewBox={logo.viewBox ?? "0 0 24 24"}
          class="w-8 h-8 fill-current text-purple-300"
          role="img"
          aria-label={logo.name}
        >
          <path d={logo.path} />
        </svg>
      </li>
    ))}
  </ul>

  <!-- Título -->
  <h3 class="text-xl font-semibold text-white mb-3">
    {title}
  </h3>

  <!-- Descripción -->
  <p class="text-gray-300 leading-relaxed text-sm">
    {description}
  </p>
</Card>
