---
import Card from "@/components/ui/Card.astro";

// `icon` es el path SVG del logo. Sin ícono, solo se ve el nombre.
// `viewBox` es el tamaño en que está dibujado: 24×24 en Simple Icons,
// pero algunos logos de src/data/extra-icons.ts usan otro.
interface Props {
  name: string;
  icon?: string;
  viewBox?: string;
}

const { name, icon, viewBox = "0 0 24 24" } = Astro.props;
---

<Card
  class={`flex items-center gap-3 px-5 py-4
          whitespace-nowrap
          border-white/10
          hover:border-purple-400/40`}
>
  <!-- Icono -->
  {icon && (
    <svg
      viewBox={viewBox}
      class="w-6 h-6 shrink-0 fill-current text-purple-300"
      aria-hidden="true"
    >
      <path d={icon} />
    </svg>
  )}

  <!-- Nombre -->
  <p class="text-gray-200 font-medium">
    {name}
  </p>
</Card>
