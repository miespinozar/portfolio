---
// Botón-enlace morado; se usa para el CV y para escribir un correo.
// `newTab` lo abre en otra pestaña (útil para el PDF).
interface Props {
  href: string;
  newTab?: boolean;
}

const { href, newTab = false } = Astro.props;
---

<a
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  class="inline-block px-6 py-3
         rounded-xl
         font-semibold text-white
         bg-purple-600
         transition-all duration-300
         hover:bg-purple-500
         hover:shadow-lg hover:shadow-purple-500/30
         motion-safe:hover:-translate-y-0.5"
>
  <slot />
</a>
