---
import { siGithub, siGitlab } from "simple-icons";

// Íconos de redes; se usan en el inicio, en contacto y en el footer.
// LinkedIn ya no está en Simple Icons, así que su path va escrito aquí (viene de v3).
const linkedinPath =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

const socials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/matias-e-0a2a15188",
    icon: linkedinPath,
  },
  {
    label: "GitHub",
    href: "https://github.com/miespinozar",
    icon: siGithub.path,
  },
  {
    label: "GitLab",
    href: "https://gitlab.com/matias.espinoza.rojas",
    icon: siGitlab.path,
  },
];
---

<div class="flex items-center gap-5">
  {socials.map((social) => (
    <a
      href={social.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={social.label}
      class="text-gray-400
             transition-colors duration-300
             hover:text-purple-400"
    >
      <!-- Icono -->
      <svg
        viewBox="0 0 24 24"
        class="w-6 h-6 fill-current"
        aria-hidden="true"
      >
        <path d={social.icon} />
      </svg>
    </a>
  ))}
</div>
