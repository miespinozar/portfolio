---
// Resumen de "Sobre mí" para el inicio; la versión completa está en /about.
import VerticalLine from "@/components/ui/VerticalLine.astro";
---

<section
  class="reveal max-w-6xl mx-auto px-6 pt-8 pb-24 md:py-24 grid grid-cols-1 md:grid-cols-[1.2fr_auto_0.8fr] gap-16 items-center"
>
  <!-- TEXTO -->
  <div class="space-y-5 text-left md:text-justify leading-relaxed text-gray-300">
    <h2 class="text-2xl font-semibold text-purple-400">
      Sobre mí
    </h2>

    <p>
      Ingeniero Civil en Informática titulado en la Universidad Andrés Bello
      con distinción Cum Laude.
    </p>

    <p>
      Apasionado por el aprendizaje, nuevas tecnologías y el trabajo en
      equipo. Se destaca por ser tenaz, disciplinado, proactivo y
      autodidacta.
    </p>

    <p>
      En desarrollo, enfocado en interfaces limpias, accesibles y bien
      estructuradas, con atención al diseño y la experiencia de usuario.
    </p>

    <p>
      Disfruta trabajar con tecnologías modernas, aprender continuamente y
      mejorar soluciones mediante código simple y mantenible.
    </p>

    <p>
      Actualmente busca oportunidades para aportar, crecer profesionalmente
      y perfeccionar sus habilidades como desarrollador.
    </p>
  </div>

  <!-- BARRA (separa el texto de la foto) -->
  <VerticalLine />

  <!-- IMAGEN -->
  <div class="flex justify-center">
    <img
      src="/profile.png"
      alt="Foto de Matías Espinoza"
      class="w-64 h-64 object-cover rounded-2xl shadow-lg shadow-black/30"
    />
  </div>
</section>
