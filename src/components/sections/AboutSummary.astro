---
// Resumen de "Sobre Matías" para el inicio; la versión completa está en /about.
import VerticalLine from "@/components/ui/VerticalLine.astro";
---

<section
  class="reveal max-w-6xl mx-auto px-6 pt-8 pb-16 md:py-20 grid grid-cols-1 md:grid-cols-[1fr_auto_0.8fr] gap-16 items-center"
>
  <!-- TEXTO -->
  <div class="max-w-xl space-y-4 leading-relaxed text-gray-300">
    <h2 class="text-2xl font-semibold text-purple-400">
      Sobre Matías
    </h2>

    <p>
      Ingeniero Civil en Informática titulado con distinción Cum Laude en la
      Universidad Andrés Bello, con casi 3 años de experiencia en desarrollo
      SAP Fiori, integraciones y QA.
    </p>

    <p>
      Se destaca por ser tenaz, disciplinado, proactivo y autodidacta, y
      disfruta construir soluciones con código simple y mantenible.
    </p>

    <p>
      Actualmente busca oportunidades para aportar en desarrollo de software
      y QA.
    </p>

    <!-- Enlace a la versión completa -->
    <a
      href="/about"
      class="inline-block pt-2
             text-sm font-semibold
             text-purple-300
             hover:text-purple-400 hover:underline"
    >
      Conoce más sobre Matías →
    </a>
  </div>

  <!-- BARRA (separa el texto de la foto) -->
  <VerticalLine />

  <!-- IMAGEN -->
  <div class="flex justify-center">
    <img
      src="/profile.png"
      alt="Foto de Matías Espinoza"
      class="w-64 h-64 object-cover rounded-2xl shadow-lg shadow-black/30"
    />
  </div>
</section>
