---
import SocialIcons from "@/components/ui/SocialIcons.astro";
import Button from "@/components/ui/Button.astro";
---

<!-- HERO -->
<section class="max-w-6xl mx-auto px-6 pt-28 pb-20 text-center">
  <h1 class="text-4xl md:text-5xl font-bold mb-6">
    Hola, soy <span class="text-purple-400">Matías Espinoza</span>
  </h1>

  <p class="text-lg md:text-xl text-gray-400 max-w-3xl mx-auto">
    Ingeniero Civil en Informática / Desarrollador.
  </p>

  <!-- Redes y CV -->
  <div class="flex flex-col items-center gap-6 mt-10">
    <SocialIcons />

    <Button href="/CV_MatiasEspinoza.pdf" newTab>
      Mi Curriculum
    </Button>
  </div>
</section>
