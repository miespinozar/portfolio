---
// El título es estático (Astro); solo las pestañas necesitan Vue para los clics.
import SectionTitle from "@/components/ui/SectionTitle.astro";
import ExperienceTabs from "@/components/sections/ExperienceTabs.vue";

interface Props {
  line?: "left" | "right";
}

const { line = "left" } = Astro.props;
---

<section class="max-w-5xl mx-auto mt-28">

  <!-- Título dinámico -->
  <SectionTitle title="Mi Experiencia" line={line} />

  <!-- Pestañas (Vue) -->
  <ExperienceTabs client:load />

</section>
