---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";

interface Props {
  line?: "left" | "right";
}

const { line = "left" } = Astro.props;

const services = [
  {
    icon: "💻",
    title: "Desarrollo Web Responsivo",
    description:
      "Construcción de sitios web modernos, adaptados a dispositivos móviles y computadoras, optimizados y con tecnologías actuales.",
  },
  {
    icon: "⚡",
    title: "Frontend",
    description:
      "Interfaces modernas, rápidas y accesibles que ofrecen una experiencia de usuario intuitiva y atractiva.",
  },
  {
    icon: "🚀",
    title: "Backend",
    description:
      "APIs y lógica de servidor con buenas prácticas, rendimiento y procesos optimizados.",
  },
];
---

<section class="mt-9 max-w-6xl mx-auto px-6">

  <!-- Título dinámico -->
  <SectionTitle title="Servicios" line={line} />

  <!-- Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mt-12 w-full">
    {services.map((service) => (
      <ServiceCard
        icon={service.icon}
        title={service.title}
        description={service.description}
      />
    ))}
  </div>

</section>
