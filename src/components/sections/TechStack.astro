---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import TechCard from "@/components/ui/TechCard.astro";
import {
  siPython,
  siOpenjdk,
  siC,
  siPhp,
  siJavascript,
  siTypescript,
  siHtml5,
  siCss,
  siTailwindcss,
  siAstro,
  siVuedotjs,
  siSpringboot,
  siDjango,
  siSap,
  siMysql,
  siPostgresql,
  siSqlite,
  siJunit5,
  siSelenium,
  siPostman,
  siCypress,
  siGit,
  siJira,
} from "simple-icons";
import { siApacheCamel, siSqlServer } from "@/data/extra-icons";

interface Props {
  line?: "left" | "right";
}

const { line = "left" } = Astro.props;

// Los logos vienen de Simple Icons y quedan dentro del sitio al compilar.
// Apache Camel y SQL Server no están ahí: sus logos vienen de src/data/extra-icons.ts.
const techs = [
  // Lenguajes
  { name: "Python", icon: siPython.path },
  { name: "Java", icon: siOpenjdk.path },
  { name: "C", icon: siC.path },
  { name: "PHP", icon: siPhp.path },
  { name: "JavaScript", icon: siJavascript.path },
  { name: "TypeScript", icon: siTypescript.path },

  // Frontend
  { name: "HTML5", icon: siHtml5.path },
  { name: "CSS3", icon: siCss.path },
  { name: "Tailwind CSS", icon: siTailwindcss.path },
  { name: "Astro", icon: siAstro.path },
  { name: "Vue.js", icon: siVuedotjs.path },

  // Backend e integración
  { name: "Spring Boot", icon: siSpringboot.path },
  { name: "Apache Camel", icon: siApacheCamel.path, viewBox: siApacheCamel.viewBox },
  { name: "Django", icon: siDjango.path },
  { name: "SAP Fiori / CPI", icon: siSap.path },

  // Bases de datos
  { name: "MySQL", icon: siMysql.path },
  { name: "PostgreSQL", icon: siPostgresql.path },
  { name: "SQLite", icon: siSqlite.path },
  { name: "SQL Server", icon: siSqlServer.path, viewBox: siSqlServer.viewBox },

  // Testing
  { name: "JUnit", icon: siJunit5.path },
  { name: "Selenium", icon: siSelenium.path },
  { name: "Postman", icon: siPostman.path },
  { name: "Cypress", icon: siCypress.path },

  // Herramientas
  { name: "Git / GitHub", icon: siGit.path },
  { name: "Jira", icon: siJira.path },
];

// La lista va dos veces seguidas: cuando la primera termina de pasar,
// la animación vuelve al inicio sin que se note el salto.
const loop = [...techs, ...techs];
---

<section class="reveal mt-12 max-w-5xl mx-auto">
  <!-- Título dinámico -->
  <SectionTitle title="Stack Tecnológico" line={line} />

  <!-- Descripción -->
  <p class="text-gray-400 mt-4 mb-10 leading-relaxed">
    Herramientas y tecnologías que utiliza para construir aplicaciones modernas,
    limpias y mantenibles.
  </p>

  <!-- Carrusel -->
  <div class="tech-strip overflow-hidden py-2" aria-label="Tecnologías">
    <ul class="tech-track flex gap-5 w-max">
      {loop.map((tech, i) => (
        <li aria-hidden={i >= techs.length ? "true" : undefined}>
          <TechCard
            name={tech.name}
            icon={tech.icon}
            viewBox={tech.viewBox}
          />
        </li>
      ))}
    </ul>
  </div>
</section>
