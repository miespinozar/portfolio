---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Card from "@/components/ui/Card.astro";

interface Props {
  line?: "left" | "right";
}

const { line = "left" } = Astro.props;

// `meta` es la institución (y la fecha si la hay); va arriba, en chico.
// `href` y `linkLabel` son el enlace al certificado; se abre en otra pestaña.
const education = [
  {
    meta: "Universidad Andrés Bello",
    title: "Ingeniería Civil en Informática",
    text: "Titulado con distinción Cum Laude.",
    href: "https://certificados.unab.cl/index.php/tyg/descargar/27137",
    linkLabel: "Ver título",
  },
  {
    meta: "IBM · Credly",
    title: "IBM Data Science",
    text: "Certificación profesional.",
    href: "https://www.credly.com/badges/59242435-c682-482f-b3de-fe9aab57fb57/print",
    linkLabel: "Ver credencial",
  },
  {
    meta: "EF SET · Abril 2026",
    title: "Inglés C2 Proficiente",
    text: "Lectura C1, comprensión auditiva C2. Español nativo.",
    href: "https://cert.efset.org/es/NPgaMX",
    linkLabel: "Ver certificado",
  },
];
---

<section class="reveal mt-9 max-w-6xl mx-auto md:px-6">

  <!-- Título dinámico -->
  <SectionTitle title="Educación" line={line} />

  <!-- Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mt-12 w-full">
    {education.map((item) => (
      <Card
        class={`w-full p-8
                border-purple-500/40
                hover:border-purple-400`}
      >
        <!-- Institución -->
        <p class="text-cyan-400 text-sm font-semibold mb-3">
          {item.meta}
        </p>

        <!-- Título -->
        <h3 class="text-xl font-semibold text-white mb-3">
          {item.title}
        </h3>

        <!-- Detalle -->
        <p class="text-gray-300 leading-relaxed text-sm">
          {item.text}
        </p>

        <!-- Enlace al certificado -->
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-5
                 text-sm font-semibold
                 text-purple-300
                 hover:text-purple-400 hover:underline"
        >
          {item.linkLabel} →
        </a>
      </Card>
    ))}
  </div>

</section>
