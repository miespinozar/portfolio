---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/layouts/Navbar.astro";
import Footer from "@/layouts/Footer.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";

// Proyectos: para agregar uno, suma un objeto aquí.
// `href` y `linkLabel` son opcionales: sin ellos, la tarjeta no muestra botón.
const projects = [
  {
    name: "Nimbo",
    status: "En desarrollo · v0.3.2",
    summary:
      "Cliente de escritorio para nube personal, al estilo de Google Drive, conectado a OneDrive. Una sola base de código con dos ediciones: Nimbo para Windows y Nimbus para Linux.",
    features: [
      "Inicio de sesión con Microsoft mediante OAuth con PKCE; los tokens se guardan en el llavero del sistema, nunca en el repositorio.",
      "Subida, descarga y creación de carpetas, más sincronización en dos sentidos entre una carpeta local y OneDrive.",
      "Instalador .msi para Windows y paquetes rpm y deb para Linux.",
      "Integración continua en GitLab: formato, clippy, pruebas, detección de secretos y auditoría de dependencias.",
    ],
    tags: [
      "Tauri 2",
      "Vue 3",
      "TypeScript",
      "Rust",
      "SQLite",
      "Tailwind CSS",
      "Microsoft Graph",
    ],
    href: "https://gitlab.com/matias.espinoza.rojas/nimbo",
    linkLabel: "Ver en GitLab",
  },
  {
    name: "Este portafolio",
    status: "En desarrollo",
    summary:
      "Sitio personal multipágina hecho a mano, con componentes reutilizables y diseño adaptable al celular.",
    features: [
      "Páginas estáticas con Astro; Vue solo donde hace falta interacción, como las pestañas de experiencia.",
      "Logos de Simple Icons incluidos al compilar, sin depender de un CDN.",
      "Menú colapsable en el celular y título y descripción propios en cada página.",
    ],
    tags: ["Astro 5", "Vue 3", "Tailwind CSS 4", "TypeScript"],
    href: "https://github.com/miespinozar/portfolio",
    linkLabel: "Ver en GitHub",
  },
  {
    name: "Sistema de gestión de auditorías ISO 27001",
    status: "Proyecto de tesis",
    summary:
      "Plataforma para gestionar auditorías de sistemas de información en empresas que operan bajo la norma ISO 27001.",
    features: [
      "Proyecto de tesis de Ingeniería Civil en Informática.",
      "Desarrollado bajo metodología Scrum++.",
    ],
    tags: ["Django", "Python", "PostgreSQL", "JavaScript"],
  },
  {
    name: "Digitalización de una peluquería",
    status: "Proyecto universitario",
    summary:
      "Aplicación web para digitalizar una peluquería, publicada en Heroku.",
    features: [
      "Desarrollado bajo metodología Scrum++.",
    ],
    tags: ["Django", "Python", "SQLite", "Heroku"],
  },
];
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de Matías Espinoza: Nimbo, un cliente de escritorio para OneDrive hecho con Tauri, Vue y Rust, este portafolio y proyectos académicos con Django."
>
  <Navbar />

  <main class="max-w-4xl mx-auto px-6 pt-32 md:pt-52 pb-32">
    <!-- Título -->
    <h1 class="text-4xl md:text-5xl font-bold text-white text-center mb-6">
      Proyectos
    </h1>

    <!-- Texto -->
    <p class="text-lg text-gray-300 leading-relaxed text-center mb-16">
      Proyectos personales y académicos.
    </p>

    <!-- Lista de proyectos -->
    <div class="space-y-10">
      {projects.map((project) => (
        <div class="reveal">
          <!-- El div lleva la animación de aparición; la tarjeta ya tiene la suya al pasar el mouse -->
          <ProjectCard
            name={project.name}
            status={project.status}
            summary={project.summary}
            features={project.features}
            tags={project.tags}
            href={project.href}
            linkLabel={project.linkLabel}
          />
        </div>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
