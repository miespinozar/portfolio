---
import { url } from "@/utils/url";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/layouts/Navbar.astro";
import Footer from "@/layouts/Footer.astro";
import Button from "@/components/ui/Button.astro";
---

<!-- Página que se muestra cuando alguien entra a una dirección que no existe -->
<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida."
>
  <Navbar />

  <main id="contenido" class="max-w-3xl mx-auto px-6 pt-52 pb-32 text-center">
    <!-- Código de error -->
    <p class="text-7xl md:text-8xl font-bold text-white text-glow mb-6">
      404
    </p>

    <!-- Título -->
    <h1 class="text-2xl md:text-3xl font-semibold text-white mb-4">
      Esta página no existe
    </h1>

    <!-- Texto -->
    <p class="text-lg text-gray-300 leading-relaxed mb-10">
      Puede que el enlace esté mal escrito o que la página se haya movido.
    </p>

    <!-- Botones -->
    <div class="flex flex-wrap justify-center gap-4">
      <Button href={url("/")}>
        Volver al inicio
      </Button>

      <Button href={url("/projects")}>
        Ver proyectos
      </Button>
    </div>
  </main>

  <Footer />
</BaseLayout>
