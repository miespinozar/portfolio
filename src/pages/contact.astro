---
import { url } from "@/utils/url";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/layouts/Navbar.astro";
import Footer from "@/layouts/Footer.astro";
import SocialIcons from "@/components/ui/SocialIcons.astro";
import Button from "@/components/ui/Button.astro";

const email = "matias.espinoza.rojas@gmail.com";
---

<BaseLayout
  title="Contacto"
  description="Contacta a Matías Espinoza, Ingeniero Civil en Informática y desarrollador: correo, currículum, LinkedIn, GitHub y GitLab."
>
  <Navbar />

  <main class="max-w-3xl mx-auto px-6 pt-52 pb-32 text-center">
    <!-- Título -->
    <h1 class="text-4xl md:text-5xl font-bold text-white text-glow mb-6">
      ¿Buscas a alguien para tu equipo?
    </h1>

    <!-- Texto -->
    <p class="text-lg text-gray-300 leading-relaxed mb-10">
      Matías está disponible para nuevas oportunidades. ¡Escríbele!
    </p>

    <!-- Botones -->
    <div class="flex flex-wrap justify-center gap-4">
      <Button href={`mailto:${email}`}>
        Enviar un correo
      </Button>

      <Button href={url("/CV_MatiasEspinoza.pdf")} newTab>
        Ver currículum
      </Button>
    </div>

    <!-- Correo a la vista, por si no hay app de correo -->
    <a
      href={`mailto:${email}`}
      class="inline-block mt-8
             text-purple-300
             hover:text-purple-400 hover:underline"
    >
      {email}
    </a>

    <!-- Redes -->
    <div class="flex justify-center mt-10">
      <SocialIcons />
    </div>
  </main>

  <Footer />
</BaseLayout>
